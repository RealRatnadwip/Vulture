# Database (Tiger Data PostgreSQL / Supabase / Neon / Local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vulture

# Auth0 Authentication
AUTH0_SECRET=32_bytes_random_secret_at_least_32_characters_long_for_auth0
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://vulture-demo.us.auth0.com
AUTH0_CLIENT_ID=vulture_auth0_client_id
AUTH0_CLIENT_SECRET=vulture_auth0_client_secret

# ElevenLabs Speech-to-Text
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode (Allows instant live demo testing with seed users & fallback classification if APIs aren't provided)
DEMO_MODE=true
