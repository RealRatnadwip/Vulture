# -------------------------------------------------------------
# VULTURE — environment variables
# fill what you have. if DEMO_MODE=true, everything runs locally
# with simulated personas & mock fallback classification.
# -------------------------------------------------------------

# database (tiger data postgresql / neon / supabase / local postgres)
DATABASE_URL=

# auth0 (leave empty if testing in demo mode)
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# elevenlabs (voice-to-text transcription engine)
ELEVENLABS_API_KEY=

# google gemini (urgency rating & time-decay triage)
GEMINI_API_KEY=

# app base url
NEXT_PUBLIC_APP_URL=http://localhost:3000

# demo mode: toggle true for instant offline/eval testing
DEMO_MODE=true
